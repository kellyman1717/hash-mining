# Template config — aman di-commit. Copy ke .env, isi nilai asli.
#
# Wajib (untuk kedua binary):
PRIVATE_KEY=0xYOUR_64_HEX_PRIVATE_KEY_HERE

# RPC URL Ethereum mainnet.
# hash-miner-rs membaca RPC_URL; pfft-miner-rs membaca ETH_RPC (atau RPC_URL).
RPC_URL=https://eth.llamarpc.com
ETH_RPC=https://ethereum-rpc.publicnode.com

# CPU thread count (fallback ketika GPU tidak tersedia / dimatikan).
MINER_THREADS=8

# GPU control. "1" = wajib pakai GPU (gagal init = abort).
# "auto" = pakai GPU kalau bisa, kalau gagal init silently fall back ke CPU.
# "0" = matikan GPU, pakai CPU saja.
GPU=1

# GPU batch size (jumlah nonce per kernel dispatch). Default 2^22 = 4_194_304.
# Naikkan kalau GPU lo gede (4M attempts/round = ~5–10ms di GPU modern).
GPU_BATCH=4194304

# EIP-1559 gas tuning (gwei).
PRIORITY_GWEI=2
MAX_FEE_GWEI=100
# GAS_LIMIT_OVERRIDE=200000   # opsional, pakai estimasi alloy kalau di-comment

# PFFT-only: jeda antara round (detik).
PAUSE_BETWEEN_ROUNDS=5
